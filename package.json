{
  "name": "@growy/n8n-nodes-tools-chatwoot",
  "version": "0.5.1",
  "description": "n8n community nodes and AI tools for the Chatwoot API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chatwoot",
    "help-center",
    "ai-tools"
  ],
  "license": "MIT",
  "author": "Growy",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate.ts",
    "compile": "tsc && for d in nodes/*/; do cp $d*.svg dist/$d; done",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.ts",
    "build": "pnpm generate --update && pnpm compile && pnpm check",
    "prepublishOnly": "pnpm compile && pnpm check"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Chatwoot/Chatwoot.node.js",
      "dist/nodes/ChatwootTrigger/ChatwootTrigger.node.js"
    ],
    "credentials": [
      "dist/credentials/ChatwootToolsApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.0.0"
  },
  "homepage": "https://github.com/ZahirElIsaac/n8n-nodes-tools-chatwoot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZahirElIsaac/n8n-nodes-tools-chatwoot.git"
  },
  "bugs": {
    "url": "https://github.com/ZahirElIsaac/n8n-nodes-tools-chatwoot/issues"
  }
}
