{
  "name": "@growy/n8n-nodes-tools-chatwoot",
  "version": "0.2.1",
  "description": "n8n community nodes and AI tools for the Chatwoot API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chatwoot"
  ],
  "license": "MIT",
  "author": "Growy",
  "main": "index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && for d in nodes/*/; do cp $d*.svg dist/$d; done",
    "prepublishOnly": "pnpm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Chatwoot/Chatwoot.node.js",
      "dist/nodes/ChatwootPlatform/ChatwootPlatform.node.js",
      "dist/nodes/ChatwootTrigger/ChatwootTrigger.node.js",
      "dist/nodes/ChatwootHelpCenter/ChatwootHelpCenter.node.js"
    ],
    "credentials": [
      "dist/credentials/ChatwootPlatformApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
