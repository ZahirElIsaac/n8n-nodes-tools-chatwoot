{
  "name": "@growy/n8n-nodes-tools-chatwoot",
  "version": "0.1.3",
  "description": "n8n community nodes and AI tools for Chatwoot (Help Center)",
  "keywords": ["n8n-community-node-package", "n8n", "chatwoot", "help-center"],
  "license": "MIT",
  "author": "Growy",
  "main": "index.js",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc && cp nodes/ChatwootHelpCenter/chatwoot.svg dist/nodes/ChatwootHelpCenter/",
    "prepublishOnly": "pnpm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": ["dist/nodes/ChatwootHelpCenter/ChatwootHelpCenter.node.js"]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
